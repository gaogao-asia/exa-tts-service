# exa-tts-service environment.
# Local compose: copy to an untracked `.env.dev` (optional; compose loads it when present).
# ECS: set these on the task definition; TTS_SERVICE_TOKEN comes from Secrets Manager.
# Voice, language and speed are not configurable here: they are fixed in app/settings.py.

# Bearer token exa-dashboard-api sends on POST /synthesize. Must equal TTS_SERVICE_TOKEN
# in exa-dashboard-api. Required unless FLASK_ENV=development, where an empty token
# skips the check; the service refuses to start without it otherwise.
TTS_SERVICE_TOKEN=local-dev-token

# mp3 or wav. Must equal EXPRESSION_AUDIO_FORMAT in exa-dashboard-api.
AUDIO_FORMAT=mp3

# gunicorn workers (staging/prod image stages). Each worker loads its own model
# (~0.5–1 GB RAM); start at about the task's vCPU count.
TTS_WORKERS=2

# gunicorn worker timeout in seconds. Keep it <= KOKORO_TTS_TIMEOUT_MS in
# exa-dashboard-api (30 s), so a request the API gave up on frees its worker.
TTS_TIMEOUT_S=30

# Torch threads per worker. Keep TTS_WORKERS x OMP_NUM_THREADS <= vCPU.
# Leave unset for the torch default.
# OMP_NUM_THREADS=1

# Set by the image stage (development / staging / production); override only to test.
# FLASK_ENV=development

# Port the service listens on inside the container (set to 8080 by the image).
# PORT=8080

# docker compose only: host port of the dev service (http://localhost:8090).
TTS_PORT=8090
